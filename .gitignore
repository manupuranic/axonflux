# ---- Claude Code working directory ----
# ignore contents (not the dir itself) so specific skills can be re-included —
# git never descends into a fully-excluded directory
.claude/*
!.claude/skills/
.claude/skills/*
# project-authored skills only; installed third-party skills stay local
!.claude/skills/update-progress/

# ---- Skills (project-local, not tracked) ----
.agents/

# ---- Git worktrees ----
.worktrees/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

# ---- Python tooling ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.cache/

# ---- VS Code ----
.vscode/
!.vscode/launch.json

# ---- OS junk ----
.DS_Store
Thumbs.db

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Data files (VERY IMPORTANT) ----
data/*
!data/sample/
exports/
*.csv
# sample CSVs are regenerated by scripts/demo_reset.py — no need to track
*.xlsx
*.xls
*.ods
*.zip
scripts/er4u_export.py

# ---- Logs ----
*.log
logs/*
!logs/.gitkeep

# ---- SQL dumps / local DB ----
*.dump
*.sql.bak

# ---- Secrets / credentials ----
*.pem
*.key
*.crt
*.json
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/components.json
!.vscode/launch.json
!api/tools/pamphlets/themes/*.json
secrets/

# ---- Node (if added later) ----
node_modules/
.terraform/
terraform.tfstate
terraform.tfstate.backup
*.exe